# Strava API credentials - Get these from https://www.strava.com/settings/api
# Replace with your actual Client ID from the Strava API Management Page
STRAVA_CLIENT_ID=00000

# Replace with your actual Client Secret from the Strava API Management Page
STRAVA_CLIENT_SECRET=aaaaaa

# Access token obtained by running: python strava_local_client.py get_write_token
# Replace with the token you receive after authorizing the application
STRAVA_UPLOADER_TOKEN=your_strava_token_here